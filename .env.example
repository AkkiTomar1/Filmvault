# Get a free API key from https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# Get a free API key from https://www.watchmode.com
# Used to deep-link provider chips to each platform's watch page for a movie.
VITE_WATCHMODE_API_KEY=your_watchmode_api_key_here

# Optional: force the Where to Watch region regardless of browser locale.
# Must be a 2-letter code in your Watchmode plan (free tier enables 3: CA/IN/RU).
# Unset = region derived from the browser language.
VITE_WATCHMODE_REGION=

# Base URL of the Filmvault accounts API (server/, deployed to Render).
# Public by design — it holds no secret. Only the anon key convention matters,
# so it is safe as a VITE_ var. Without it the app runs fully offline as a
# guest (localStorage watchlist); all account features are disabled.
VITE_API_URL=http://localhost:4000