# ---- Runtime ----
NODE_ENV=development
PORT=4000

# Postgres connection string. In production this comes from Render's internal
# DB URL, never from a committed file.
DATABASE_URL=postgresql://filmvault:filmvault@localhost:5432/filmvault

# Signs access tokens. Must be >= 32 chars. Required in production — the server
# refuses to boot without it. Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789

# Where the SPA lives. Used to build the links inside verification / reset
# emails, and (with CORS_ORIGINS) as the allowed browser origin.
APP_URL=https://akkitomar1.github.io/Filmvault

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=https://akkitomar1.github.io,http://localhost:5173

# 15 minutes. Kept short because the access token is held in JS memory.
ACCESS_TOKEN_TTL_SECONDS=900
# 30 days.
REFRESH_TOKEN_TTL_DAYS=30

# ---- Email ----
# `console` logs the verification / reset link to stdout instead of sending.
# Convenient locally; MUST be `smtp` in production or nobody can verify.
EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Filmvault <no-reply@example.com>

# Set when running behind a proxy (Render) so express-rate-limit sees the real
# client IP instead of Render's internal one.
TRUST_PROXY=1