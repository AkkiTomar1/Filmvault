# ---- Runtime ----
NODE_ENV=development
PORT=5000

# Client origins allowed by CORS
CORS_ORIGIN=http://localhost:5173
CORS_ORIGINS=https://akkitomar1.github.io,http://localhost:5173

# Secret for signing JWT tokens (replace with a secure random key in production)
JWT_SECRET=filmvault_super_secure_jwt_secret_key_change_me_in_production

# MongoDB connection string (Mongoose backend)
MONGODB_URI=mongodb://127.0.0.1:27017/filmvault

# Postgres connection string (Prisma backend - optional)
DATABASE_URL=postgresql://filmvault:filmvault@localhost:5432/filmvault

# SPA URL
APP_URL=https://akkitomar1.github.io/Filmvault

# Token TTL
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Email (optional)
EMAIL_MODE=console
SMTP_PORT=587
SMTP_FROM=Filmvault <no-reply@example.com>
