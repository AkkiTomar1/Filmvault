{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/index.ts",
    "src/config/**/*",
    "src/controllers/**/*",
    "src/middleware/auth.ts",
    "src/models/**/*",
    "src/routes/authRoutes.ts",
    "src/routes/profileRoutes.ts",
    "src/routes/watchlistRoutes.ts"
  ]
}
